	measure Aktiv_Filter_Tekst = ```
			
			// 1. Sjekk filter på År
			VAR Valgt_Ar = 
			    IF(
			        ISFILTERED(dim_date[Ar]),
			        CONCATENATEX(VALUES(dim_date[Ar]), dim_date[Ar], ", "),
			        "Alle år"
			    )
			
			// 2. Sjekk filter på ÅÅÅÅ-MM
			VAR Valgt_Maned = 
			    IF(
			        ISFILTERED(dim_date[_Ar_Maned]),
			        CONCATENATEX(VALUES(dim_date[_Ar_Maned]), FORMAT(dim_date[_Ar_Maned], "yyyy-MM"), ", "),
			        "Alle måneder"
			    )
			
			// 3. Sjekk filter på KOSTRA Funksjon
			VAR AntallValgteFunksjoner = COUNTROWS(VALUES(dim_funksjon[Funksjon_Kode_Navn]))
			VAR Valgt_Funksjon = 
			    IF(
			        ISFILTERED(dim_funksjon[KOSTRA_Funksjon_Navn]),
			        IF(
			            AntallValgteFunksjoner > 3,
			            AntallValgteFunksjoner & " funksjoner valgt",
			            CONCATENATEX(VALUES(dim_funksjon[KOSTRA_Funksjon_Navn]), dim_funksjon[KOSTRA_Funksjon_Navn], ", ")
			        ),
			        "Alle funksjoner"
			    )

			// 4. Sjekk filter på Ansvar
			VAR Valgt_Ansvar =
			    IF(
			        ISFILTERED(dim_ansvar[Ansvar_Navn]),
			        CONCATENATEX(VALUES(dim_ansvar[Ansvar_Navn]), dim_ansvar[Ansvar_Navn], ", "),
			        "Alle ansvarssteder"
			    )
			
			RETURN
			    "📅 Periode: " & Valgt_Ar & " " & Valgt_Maned & " | 🏛️ Funksjon: " & Valgt_Funksjon & " | 📍 Ansvar: " & Valgt_Ansvar
			```
		lineageTag: a970dcf8-2519-4de3-8f39-24a8868593f8

	measure '(Tekst & Emoji)Status_Indikator' = ```
			
			VAR Avvik = [Avvik YTD]
			VAR BurnRate = [Burn_Rate_Pct YTD]
			RETURN
			    SWITCH(
			        TRUE(),
			        Avvik > 200000 || BurnRate > 1.25, "🔴 KRITISK AVVIK",
			        Avvik > 50000 || BurnRate > 1.05,  "🟡 ADVARSEL",
			        "🟢 I RUTE"
			    )
			```
		lineageTag: 3e10f066-d9d8-4f9d-8a4d-5fa23dec9945

	measure Status_Color_Hex = ```
			
			VAR Avvik = [Avvik YTD]
			VAR BurnRate = [Burn_Rate_Pct YTD]
			RETURN
			    SWITCH(
			        TRUE(),
			        Avvik > 200000 || BurnRate > 1.25, "#D32F2F",
			        Avvik > 50000 || BurnRate > 1.05,  "#ED6C02",
			        "#2E7D32"
			    )
			```
		lineageTag: 6bf67e72-0262-4627-9d86-8486435ce5cf

	measure Regnskap_MoM_Forrige =
			
			CALCULATE(
			    [Sum_Regnskap],
			    PREVIOUSMONTH(dim_date[Dato])
			)
		displayFolder: "1. Kjernetall & Regnskapsbane (Min Hverdag)"
		formatString: #,0
		lineageTag: 9c0fee90-d206-4ff4-8cb1-47edce051acb

	measure MoM_Endring_Regnskap =
			
			IF(
			    ISBLANK([Regnskap_MoM_Forrige]),
			    BLANK(),
			    [Sum_Regnskap] - [Regnskap_MoM_Forrige]
			)
		displayFolder: "1. Kjernetall & Regnskapsbane (Min Hverdag)"
		formatString: #,0
		lineageTag: d572c6fb-4bfe-4a20-8685-0c867c3f5811

	measure MoM_Endring_Pct =
			
			DIVIDE([MoM_Endring_Regnskap], [Regnskap_MoM_Forrige], 0)
		displayFolder: "1. Kjernetall & Regnskapsbane (Min Hverdag)"
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 372ed3ca-8ffd-4b92-8890-9e0aeaad2022

	measure MoM_Status_Symbol = ```
			
			VAR Pct = [MoM_Endring_Pct]
			RETURN
			    IF(
			        ISBLANK([Regnskap_MoM_Forrige]),
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            Pct > 0.01,  "🔴 ⬆️",
			            Pct < -0.01, "🟢 ⬇️",
			            "🟡 ➡️"
			        )
			    )
			```
		lineageTag: 75550840-ae9f-48d8-90a2-c463e67050ea

	measure MoM_Status_Tekst = ```
			
			VAR Pct = [MoM_Endring_Pct]
			RETURN
			    IF(
			        ISBLANK([Regnskap_MoM_Forrige]),
			        "Første periode",
			        SWITCH(
			            TRUE(),
			            Pct > 0.05,  "🔴 Vesentlig økning (> +5%)",
			            Pct > 0.01,  "🟡 Moderat økning (+1% til +5%)",
			            Pct < -0.05, "🟢 Vesentlig reduksjon (< -5%)",
			            Pct < -0.01, "🟢 Moderat reduksjon (-1% til -5%)",
			            "⚪ Stabil drift (+/- 1%)"
			        )
			    )
			```
		lineageTag: 894d9754-4a97-42b0-a7c1-c1fbc619e490

	measure Regnskap_Rullende_3M =
			
			CALCULATE(
			    [Sum_Regnskap],
			    DATESINPERIOD(dim_date[Dato], MAX(dim_date[Dato]), -3, MONTH)
			)
		displayFolder: "1. Kjernetall & Regnskapsbane (Min Hverdag)"
		formatString: #,0
		lineageTag: dba4fb97-da39-43b6-8adb-fd1ddd5a8219

	measure EAC_Prognose = ```
			
			VAR MaksMnd = MAX(dim_date[Maned_Nummer])
			VAR GjenvMnd = 12 - COALESCE(MaksMnd, 8)
			VAR YTD_Regn = [Sum_Regnskap]
			VAR MndSnitt = DIVIDE(YTD_Regn, MaksMnd, 0)
			RETURN
			    YTD_Regn + (MndSnitt * GjenvMnd)
			```
		formatString: #,0
		lineageTag: 9bcc8cbb-440c-48f8-bc6e-8ab0dd1af106

	measure EAC_Avvik = ```
			
			VAR MaksMnd = MAX(dim_date[Maned_Nummer])
			VAR EstArsbudsjett = [Sum_Budsjett] * DIVIDE(12, COALESCE(MaksMnd, 8), 1)
			RETURN
			    [EAC_Prognose] - EstArsbudsjett
			```
		formatString: #,0
		lineageTag: 012607f5-174e-4c0d-a46e-7068132bd368


