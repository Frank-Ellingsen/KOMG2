	measure Simulert_Vakanssparing = ```
			
			// 1,5 måneders vakanssparing på 4,0 vakante årsverk
			VAR Vakanser = 4.0
			VAR SnittLonn = DIVIDE([Basislonnsmasse_2024], 168.0, 538869)
			RETURN
			    Vakanser * (SnittLonn / 12) * 1.5 * (1 + [KLP_Pensjonspremie_Sats] + [AGA_Sats])
			```
		formatString: #,0
		lineageTag: d767e35b-46fa-4fda-b138-ca3a155c7a2b

	measure Simulert_Vikardekning_Kostnad = ```
			
			// 80 % vikardekningsgrad ved sykefravær
			VAR Fraverstimer = 168.0 * 1650 * 0.085
			VAR Timesats = 350.0
			RETURN
			    Fraverstimer * 0.80 * Timesats * (1 + [AGA_Sats])
			```
		formatString: #,0
		lineageTag: 29e7a05c-0a07-421e-bc86-29c153b6d834


