	measure Selvkost_Dekningsgrad_Pct =
			
			DIVIDE([Selvkost_Faktisk_Gebyrinntekt], [Selvkost_Gebyrkrav], 0)
		displayFolder: "6. Selvkost & Fakturering"
		formatString: 0.0%
		lineageTag: df837d28-930d-4447-8aff-9fa2274914dd

	measure Selvkost_Fondsavsetning =
			
			[Selvkost_Faktisk_Gebyrinntekt] - [Selvkost_Gebyrkrav]
		displayFolder: "6. Selvkost & Fakturering"
		formatString: #,0
		lineageTag: bc256c52-d079-41a1-97e0-6fa6f73489ba

	measure Adhoc_Intern_Selvkost_Timesats = ```
			
			// Intern selvkostlønn (Art 780/380) med 1 650 t, KLP, AGA 14,1% og 12% overhead
			VAR SnittLonn = 580000
			VAR Sosiale = SnittLonn * (0.148 + 0.141)
			VAR Overhead = (SnittLonn + Sosiale) * 0.12
			RETURN
			    ROUND(DIVIDE(SnittLonn + Sosiale + Overhead, 1650, 0), 2)
			```
		formatString: #,0.00 "kr"
		lineageTag: 3a57d086-25bf-4a0c-bdd0-79725edb2d54

	measure Adhoc_Ekstern_Lokalleie_Standard =
			
