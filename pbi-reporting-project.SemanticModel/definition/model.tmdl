model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dim_ansvar","dim_date","dim_funksjon","dim_kontoplan","fact_modelready"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_ansvar
ref table dim_date
ref table dim_funksjon
ref table dim_kontoplan
ref table fact_modelready
ref table _Measures

ref cultureInfo en-US

